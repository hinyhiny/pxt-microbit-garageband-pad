{
    "name": "garageband-pad",
    "version": "1.2.0",
    "description": "Bluetooth (BLE) MIDI pad controller for the micro:bit V2: hold the buttons to play GarageBand on an iPad",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "midi": "github:microsoft/pxt-midi#v2.1.11",
        "bluetooth-midi": "github:RBilsland/pxt-bluetooth-midi"
    },
    "files": [
        "README.md",
        "README.ja.md",
        "garageband-pad.ts",
        "_locales/ja/garageband-pad-strings.json",
        "_locales/ja/garageband-pad-jsdoc-strings.json"
    ],
    "testFiles": [
        "tests.ts"
    ],
    "public": true,
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj"
}
